#!/usr/bin/env python3
"""Fetch the fixed public catalog; send only bounded badge metadata to QML."""
import json
import signal
import sys
import urllib.request

LIMIT = 32 * 1024 * 1024

def compact(catalog):
    if not isinstance(catalog, dict) or not isinstance(catalog.get('plugins'), list):
        raise ValueError('Invalid catalog')
    result = []
    fields = ('id', 'verificationStatus', 'verificationCommit', 'verificationSnapshotStatus', 'verificationCoverage', 'upstreamObservedCommit')
    for entry in catalog['plugins'][:10000]:
        if not isinstance(entry, dict) or not isinstance(entry.get('id'), str):
            continue
        row = {key: value[:256] for key in fields if isinstance(value := entry.get(key), str)}
        release = entry.get('repositoryRelease')
        url = release.get('url') if isinstance(release, dict) else None
        if isinstance(url, str) and url.startswith('https://github.com/') and len(url) <= 2048:
            row['repositoryRelease'] = {'url': url}
        result.append(row)
    return {'plugins': result}

def main():
    signal.alarm(25)
    try:
        with urllib.request.urlopen('https://plugins.omarchy.org/catalog.json', timeout=20) as response:
            raw = response.read(LIMIT + 1)
        if len(raw) > LIMIT:
            raise ValueError('Catalog exceeds 32 MiB limit')
        print(json.dumps(compact(json.loads(raw)), separators=(',', ':')))
    except (OSError, ValueError) as error:
        print('Catalog fetch failed: '+str(error), file=sys.stderr)
        return 1
    finally:
        signal.alarm(0)
    return 0

if __name__ == '__main__':
    sys.exit(main())
