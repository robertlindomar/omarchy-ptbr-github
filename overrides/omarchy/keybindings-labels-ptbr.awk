# Tradução visual de labels do painel omarchy-menu-keybindings (pt-BR).
# Entrada: registros tab-separados; apenas o campo 1 ("TECLA → label") é traduzido.

function tr_label(label,    t) {
  t = label

  if (match(t, /^Switch to workspace ([0-9]+)$/, m))
    return "Ir para área de trabalho " m[1]
  if (match(t, /^Move window to workspace ([0-9]+)$/, m))
    return "Mover janela para área de trabalho " m[1]
  if (match(t, /^Move window silently to workspace ([0-9]+)$/, m))
    return "Mover janela silenciosamente para área de trabalho " m[1]
  if (match(t, /^Switch to group window ([0-9]+)$/, m))
    return "Ir para janela do grupo " m[1]

  if (t in EXACT) return EXACT[t]
  return t
}

function tr_line(line,    pos, label) {
  pos = index(line, " → ")
  if (pos == 0) return line
  label = substr(line, pos + 3)
  return substr(line, 1, pos + 2) tr_label(label)
}

