{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "robertlindomar.omarchy-ptbr.indicators",
          "pinned": [
            "StayAwake",
            "Dnd",
            "Reminder"
          ]
        },
        {
          "id": "robertlindomar.omarchy-ptbr.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
